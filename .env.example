# 테스트넷 전용 니모닉. 실제 자산이 있는 니모닉은 절대 넣지 마세요.
# 새로 만들려면: npm run new-wallet
MNEMONIC=

# Tron Nile 테스트넷 (기본값 그대로 두면 됨)
TRON_FULL_HOST=https://nile.trongrid.io
NILE_USDT_ADDRESS=TXYZopYRdj2D9XRtbG411XZZ3kM5VkAeBf

# BTTC Donau 테스트넷
BTTC_RPC_URL=https://pre-rpc.bt.io/

# 실제 전송은 SEND_TX=true 를 명시했을 때만. 기본은 미리보기.
SEND_TX=false
